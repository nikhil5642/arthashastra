# Fundamental Analyst — environment config
#
# Usage:
#   cp .env.example .env
#
# Global equities analyst (US, India, China / HK, Japan, Europe, …).
#
# This project is Claude Code native: leadership / prospects / news
# scoring happens in slash commands inside Claude Code, not via an
# Anthropic API call from Python. There is no ANTHROPIC_API_KEY and
# no sandbox / live split — the analyst always runs in one mode.

# Where cached data (JSON + SQLite) lives. Relative paths resolve
# against the project root.
DATA_CACHE_DIR=data_cache

# Your own currency (ISO code). `pick` budgets are in it, and every
# listing's price — USD, HKD, JPY, GBp, … — is converted with live FX.
BASE_CURRENCY=INR

# Optional: how this tool identifies itself to SEC EDGAR (US filings
# history for backtests). Add a contact if you like: "Name you@example.com".
SEC_USER_AGENT=

# Optional: Brave Search API key for leadership web research.
# Free tier: 2000 queries/month. https://brave.com/search/api/
# If unset, the research pipeline still works off Wikipedia only.
BRAVE_API_KEY=
